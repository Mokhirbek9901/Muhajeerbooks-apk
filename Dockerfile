FROM ghcr.io/cirruslabs/flutter:stable@sha256:46691e311715845de03a3ba4753a475476936805b29431b1f00f1816981033f8 AS build
WORKDIR /app
COPY . .
# The checkout UI reads the locally cached order list to show the short display
# number immediately after a successful order. Keep the build compatible with
# both older source and source that already exposes the read-only accessor.
RUN python3 -c "from pathlib import Path;p=Path('lib/app_state.dart');s=p.read_text(encoding='utf-8');g='  List<ShopOrder> get localOrders => List.unmodifiable(_localOrders);';o='  List<Book> get books => List.unmodifiable(_books);';assert g in s or o in s;s=s if g in s else s.replace(o,g+'\\n'+o,1);p.write_text(s,encoding='utf-8')"
RUN python3 -c "from pathlib import Path;import base64;p=Path('lib/store_ui.dart');s=p.read_text(encoding='utf-8');o=base64.b64decode('J+qyveyCsCAoR3llb25nc2FuKSDigJQgb+KAmHppbSBvbGliIGtldGFtYW4n').decode();n=base64.b64decode('J+qyveyCsGRhbiAoR3llb25nc2FuKSBv4oCYemltIG9saWIga2V0YW1hbic=').decode();assert o in s;s=s.replace(o,n,1);p.write_text(s,encoding='utf-8')"
RUN python3 -c "from pathlib import Path;import base64;p=Path('lib/store_ui.dart');s=p.read_text(encoding='utf-8');o=base64.b64decode('ICAgICAgICAgICAgICAgICAgICBzdWJ0aXRsZTogY29uc3QgVGV4dCgnQkVQVUwg4oCiIFBvY2h0YSBwdWxpIG9saW5tYXlkaScpLAogICAgICAgICAgICAgICAgICAgIHNlY29uZGFyeTogY29uc3QgSWNvbihJY29ucy5zdG9yZWZyb250X291dGxpbmVkKSwKICAgICAgICAgICAgICAgICAgKSw=').decode();n=base64.b64decode('').decode();assert o in s;s=s.replace(o,n,1);p.write_text(s,encoding='utf-8')"
RUN flutter pub get
RUN flutter build web --release

FROM nginx:alpine
RUN apk add --no-cache python3 py3-pip supervisor && pip3 install --break-system-packages --no-cache-dir flask gunicorn requests
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html
COPY server /app/server
COPY supervisord.conf /etc/supervisord.conf
RUN nginx -t
EXPOSE 8080
CMD ["supervisord", "-c", "/etc/supervisord.conf"]

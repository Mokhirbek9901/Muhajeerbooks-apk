FROM ghcr.io/cirruslabs/flutter:stable

USER root
WORKDIR /src

# Dedicated Google Play release builder. Signing material is injected only at runtime.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 imagemagick \
    && rm -rf /var/lib/apt/lists/*

COPY . /src
RUN chmod +x /src/tools/play_release_entrypoint.sh

EXPOSE 8080
CMD ["/src/tools/play_release_entrypoint.sh"]
